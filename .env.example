# Copy to .env for local runs; on the host set these as environment variables.
ACCESS_CODE=choisis-un-code
SECRET_KEY=une-longue-chaine-aleatoire
# Leave DATABASE_URL empty locally (SQLite). Set it in production to a Postgres URL.
DATABASE_URL=

# Daily email report (optional). Without these the report endpoint still runs in
# ?dry=1 preview mode but sends nothing.
REPORT_TOKEN=un-secret-partage-avec-le-planificateur
RESEND_API_KEY=re_xxxxxxxx
REPORT_FROM=Combinaisons <combinaisons@ton-domaine.fr>
REPORT_TO=corinne@exemple.fr, toi@exemple.fr
REPORT_TZ=Europe/Paris
